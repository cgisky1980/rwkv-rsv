#version 450 core
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_subgroup_extended_types_float16 : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable

// 深度融合（batch 并发版）：ln1 = layer_norm(x) + 6 次 lerp(xr/xw/xk/xv/xa/xg) + state 写回。
//
//   x     : [batch, C]（slot 主序）
//   state : [batch, C]  每 slot 的 tmix_x（prev 读 + 写回）
//   gamma/beta/x_r..x_g : [C]  跨 slot 共享
//   o_r..o_g : [batch, C]
//
// 与 norm_lerp6.comp 同构，唯一差异：per-slot 张量带 `slot*C` 偏移，
// 归约仍按该 slot 的 C 段独立进行（每个 (g, slot) workgroup 冗余全 C 归约，
// x 段仅 16KB 命中 L2，开销可忽略）。
//
// dispatch: (ceil(C/BLOCK_SIZE), batch, 1)

layout(constant_id = 0) const uint C = 4096;    // Hidden size
layout(constant_id = 1) const float EPSILON = 1e-5;

const uint BLOCK_SIZE       = 256;
layout(constant_id = 2) const uint SUBGROUP_SIZE = 32;
const uint NUM_SUBGROUPS    = BLOCK_SIZE / SUBGROUP_SIZE;

shared float sketch_sum[NUM_SUBGROUPS];
shared float sketch_sq_sum[NUM_SUBGROUPS];
shared float mean;
shared float inv_std;

layout(buffer_reference) buffer InputX  { float data[]; } input_x;
layout(buffer_reference) buffer State   { float data[]; } state;
layout(buffer_reference) buffer Gamma   { float data[]; } gamma;
layout(buffer_reference) buffer Beta    { float data[]; } beta;
layout(buffer_reference) buffer CoeffR  { float data[]; } x_r;
layout(buffer_reference) buffer CoeffW  { float data[]; } x_w;
layout(buffer_reference) buffer CoeffK  { float data[]; } x_k;
layout(buffer_reference) buffer CoeffV  { float data[]; } x_v;
layout(buffer_reference) buffer CoeffA  { float data[]; } x_a;
layout(buffer_reference) buffer CoeffG  { float data[]; } x_g;
layout(buffer_reference) buffer OutR    { float data[]; } o_r;
layout(buffer_reference) buffer OutW    { float data[]; } o_w;
layout(buffer_reference) buffer OutK    { float data[]; } o_k;
layout(buffer_reference) buffer OutV    { float data[]; } o_v;
layout(buffer_reference) buffer OutA    { float data[]; } o_a;
layout(buffer_reference) buffer OutG    { float data[]; } o_g;

layout(set = 0, binding = 0, std430) uniform Params {
    InputX  input_x;
    State   state;
    Gamma   gamma;
    Beta    beta;
    CoeffR  x_r;
    CoeffW  x_w;
    CoeffK  x_k;
    CoeffV  x_v;
    CoeffA  x_a;
    CoeffG  x_g;
    OutR    o_r;
    OutW    o_w;
    OutK    o_k;
    OutV    o_v;
    OutA    o_a;
    OutG    o_g;
} params;

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint g                       = gl_WorkGroupID.x;
    const uint slot                    = gl_WorkGroupID.y;
    const uint index                   = gl_LocalInvocationIndex;
    const uint subgroup_id             = gl_SubgroupID;
    const uint subgroup_invocation_id  = gl_SubgroupInvocationID;

    InputX  input_x = params.input_x;
    State   state   = params.state;
    Gamma   gamma   = params.gamma;
    Beta    beta    = params.beta;
    CoeffR  x_r     = params.x_r;
    CoeffW  x_w     = params.x_w;
    CoeffK  x_k     = params.x_k;
    CoeffV  x_v     = params.x_v;
    CoeffA  x_a     = params.x_a;
    CoeffG  x_g     = params.x_g;
    OutR    o_r     = params.o_r;
    OutW    o_w     = params.o_w;
    OutK    o_k     = params.o_k;
    OutV    o_v     = params.o_v;
    OutA    o_a     = params.o_a;
    OutG    o_g     = params.o_g;

    const uint sbase = slot * C;

    // Phase 1: 冗余归约 —— 每个 (g, slot) 独立对该 slot 的 C 段算 mean/inv_std
    float local_sum = 0.0;
    float local_sq_sum = 0.0;
    [[unroll]]
    for (uint i = index; i < C; i += BLOCK_SIZE) {
        float value = input_x.data[sbase + i];
        local_sum += value;
        local_sq_sum += value * value;
    }
    local_sum = subgroupAdd(local_sum);
    local_sq_sum = subgroupAdd(local_sq_sum);
    if (subgroup_invocation_id == 0) {
        sketch_sum[subgroup_id] = local_sum;
        sketch_sq_sum[subgroup_id] = local_sq_sum;
    }
    barrier();
    [[unroll]]
    for (uint step = NUM_SUBGROUPS >> 1; step > 0; step >>= 1) {
        if (index < step) {
            sketch_sum[index] += sketch_sum[index + step];
            sketch_sq_sum[index] += sketch_sq_sum[index + step];
        }
        barrier();
    }
    if (index == 0) {
        float sum = sketch_sum[0];
        float sq_sum = sketch_sq_sum[0];
        mean = sum / float(C);
        float variance = sq_sum / float(C) - mean * mean;
        inv_std = inversesqrt(variance + EPSILON);
    }
    barrier();

    // Phase 2: apply 本 workgroup 负责的 C 片段
    const uint start = g * BLOCK_SIZE;
    const uint i     = start + index;
    if (i < C) {
        float val  = input_x.data[sbase + i];
        float ln1  = (val - mean) * inv_std * gamma.data[i] + beta.data[i];
        float prev = state.data[sbase + i];

        o_r.data[sbase + i] = ln1 + x_r.data[i] * (prev - ln1);
        o_w.data[sbase + i] = ln1 + x_w.data[i] * (prev - ln1);
        o_k.data[sbase + i] = ln1 + x_k.data[i] * (prev - ln1);
        o_v.data[sbase + i] = ln1 + x_v.data[i] * (prev - ln1);
        o_a.data[sbase + i] = ln1 + x_a.data[i] * (prev - ln1);
        o_g.data[sbase + i] = ln1 + x_g.data[i] * (prev - ln1);

        state.data[sbase + i] = ln1;   // tmix_x = ln1
    }
}
