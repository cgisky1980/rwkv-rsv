#version 450 core
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

// `gemm_splitk.comp` 的配套确定性归约（只编这一条，避免把大 GEMM 再编一遍）：
//   `out[i] = op( Σ_{ks=0}^{KS-1} partial[ks * ELEMS + i] )`，i 覆盖 M×N 的**行主序**输出。
// 按 ks **升序**相加 ⇒ 固定顺序、结果确定（不依赖 block 调度）。`ELEMS = M*N` 是 k 维不跨槽
// 重复的那份输出，所以 partial 布局就是 `[KS][M][N]`，与 GEMM 侧 `STRIDE_C_BATCH = M*N` 一一对应。
//
// op：0 = 覆盖写（v/a/g 链，sigmoid 仍由调用点在 f32 mid 上做）、1 = tanh 后覆盖写（w 链）。
// ⚠️ `Params` 的两个字段 = host 侧 `rparams` 的两个槽位，数量必须严格一致（见 commit
//    `5b410ec` 的那次错位崩溃）。

layout(constant_id = 0) const uint ELEMS = 65536;  // M*N
layout(constant_id = 1) const uint KS    = 4;       // split-K 分块数
layout(constant_id = 2) const uint OP    = 0;

const uint BLOCK_SIZE = 256;

layout(buffer_reference) buffer InP  { float data[]; };  // [KS][M][N]
layout(buffer_reference) buffer OutY { float data[]; };  // [M][N]

layout(set = 0, binding = 0, std430) uniform Params {
    InP  in_p;
    OutY out_y;
} params;

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint stride = BLOCK_SIZE * gl_NumWorkGroups.x;
    for (uint i = gl_GlobalInvocationID.x; i < ELEMS; i += stride) {
        float s = 0.0;
        for (uint ks = 0u; ks < KS; ks++) {
            s += params.in_p.data[ks * ELEMS + i];
        }
        params.out_y.data[i] = (OP == 1u) ? tanh(s) : s;
    }
}
