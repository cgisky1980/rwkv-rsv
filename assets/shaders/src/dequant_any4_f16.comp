#version 450 core
#extension GL_EXT_scalar_block_layout : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable

// any4 → fp16 反量化（prefill 方案A：大矩阵反量化到共享 scratch 后走 tensor-core GEMM）。
// 输入 any4 格式（W[M, K] 行主序，K 为收缩维，group=128）：
//   idx: uint32 [M, K/8]   每 uint32 打包 8 个 4-bit 索引，lane j 的索引在 bits [4j, 4j+4)
//   lut: fp16   [M, 16]    每行 16 项学习码本（组归一化域）
//   sz:  uint32 [M, K/128] 每元素 = (scale: fp16 低16位 | zero: fp16 高16位)
// 输出 fp16 [M, K] 行主序（与 load_linear_f16 上传布局一致，直接作 gemm B 矩阵）。
// 反量化：w[m,k] = scale[m,k/128] * lut[m, idx] + zero[m,k/128]
//
// 每线程处理 1 个 uint32 = 8 个权重。grid.x = ceil(M * K/8 / BLOCK_SIZE)。
// 要求 K % 128 == 0。
// 写优化：8 个 fp16 先 pack 成 4 个 uint32 存 shared，barrier 后全 warp 线性写出
//（连续 u32，完全合并）；直接逐元素 fp16 散写每 warp 指令仅 1/8 带宽利用率。

layout(constant_id = 0) const uint M = 4096;        // 行数
layout(constant_id = 1) const uint K = 4096;        // 列数（收缩维）

const uint BLOCK_SIZE = 256;
const uint KV = K / 8;    // 每行 uint32 数
const uint KG = K / 128;  // 每行 group 数

shared uint sh[BLOCK_SIZE * 4];  // 每线程 8 fp16 = 4 uint32

layout(buffer_reference) buffer InputIdx { uint data[]; }      input_idx;
layout(buffer_reference) buffer InputLut { float16_t data[]; } input_lut;
layout(buffer_reference) buffer InputSZ  { uint data[]; }      input_sz;
layout(buffer_reference) buffer OutputW  { uint data[]; }      output_w;  // fp16x2 packed

layout(set = 0, binding = 0, std430) uniform Params {
    InputIdx input_idx;
    InputLut input_lut;
    InputSZ  input_sz;
    OutputW  output_w;
} params;

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint linear = gl_GlobalInvocationID.x;
    const uint local  = gl_LocalInvocationID.x;
    const uint total  = M * KV;

    InputIdx input_idx   = params.input_idx;
    InputLut input_lut   = params.input_lut;
    InputSZ  input_sz    = params.input_sz;
    OutputW  output_w    = params.output_w;

    if (linear < total) {
        const uint m  = linear / KV;
        const uint kk = linear % KV;         // 行内 uint32 索引
        const uint g  = kk >> 4;             // group = (kk*8) / 128

        const vec2 szv = unpackFloat2x16(input_sz.data[m * KG + g]);
        const float sc = szv.x;
        const float zr = szv.y;
        const uint lut_base = m * 16;

        const uint ipack = input_idx.data[linear];

        [[unroll]]
        for (uint j = 0; j < 4; j++) {
            const uint nib0 = (ipack >> (8 * j)) & 0xFu;
            const uint nib1 = (ipack >> (8 * j + 4)) & 0xFu;
            const float w0 = sc * float(input_lut.data[lut_base + nib0]) + zr;
            const float w1 = sc * float(input_lut.data[lut_base + nib1]) + zr;
            sh[local * 4 + j] = packFloat2x16(f16vec2(float16_t(w0), float16_t(w1)));
        }
    }
    barrier();

    // 全 wg 线性写出：lane 间地址连续（每 warp 128B 事务，100% 合并）
    const uint wg_base  = gl_WorkGroupID.x * BLOCK_SIZE;
    const uint out_base = wg_base * 4;                     // 本 wg 输出起始 uint32 索引
    const uint rem      = min(total - wg_base, BLOCK_SIZE); // 本 wg 有效线程数
    for (uint j = local; j < rem * 4; j += BLOCK_SIZE) {
        output_w.data[out_base + j] = sh[j];
    }
}
