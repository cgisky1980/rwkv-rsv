#version 450 core
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable

// Token shift + time-mix 插值（batch 并发版，slot 主序 [batch, T, C]）。
//
//   x     : [batch, T, C]（slot 主序）
//   state : [batch, C]   每个 slot 各自的 token-shift 状态
//   tm    : [C]          跨 slot 共享
//   y     : [batch, T, C]
//
// 与 seq_shift.comp 唯一差异：token==0 时读**本 slot** 的状态段（slot*C），
// 且 x/y 的 token 基址含 slot 偏移。语义与 CUDA `rwkv_seq_shift_batch` 逐字对应。
//
// dispatch: (T, batch, 1)

layout(constant_id = 0) const uint C = 4096;
layout(constant_id = 1) const uint T = 1;
layout(constant_id = 2) const uint STRIDE_X_Y = 4096; // token stride of x
layout(constant_id = 3) const uint STRIDE_Y_Y = 4096; // token stride of y

const uint BLOCK_SIZE = 256;

layout(buffer_reference) buffer InputX  { float data[]; } input_x;
layout(buffer_reference) buffer InputS  { float data[]; } input_s;
layout(buffer_reference) buffer TimeMix { float data[]; } time_mix;
layout(buffer_reference) buffer Output  { float data[]; } output_y;

layout(set = 0, binding = 0, std430) uniform Params {
    InputX  input_x;
    InputS  input_s;
    TimeMix time_mix;
    Output  output_y;
} params;

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint token = gl_WorkGroupID.x;
    const uint slot  = gl_WorkGroupID.y;
    const uint index = gl_LocalInvocationID.x;
    if (token >= T) {
        return;
    }

    InputX  input_x  = params.input_x;
    InputS  input_s  = params.input_s;
    TimeMix time_mix = params.time_mix;
    Output  output_y = params.output_y;

    const uint x_base = (slot * T + token) * STRIDE_X_Y;
    const uint y_base = (slot * T + token) * STRIDE_Y_Y;
    const uint s_base = slot * C;

    for (uint i = index; i < C; i += BLOCK_SIZE) {
        const float cur = input_x.data[x_base + i];
        const float prev = (token == 0u) ? input_s.data[s_base + i]
                                         : input_x.data[x_base - STRIDE_X_Y + i];
        const float tmv = time_mix.data[i];
        output_y.data[y_base + i] = cur + tmv * (prev - cur);
    }
}
