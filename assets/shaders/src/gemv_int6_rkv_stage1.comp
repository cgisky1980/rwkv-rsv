#version 450 core
#extension GL_EXT_scalar_block_layout : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable

// int6（N-major）深度融合：r/k/v 三路（量化权重）+ 四条 lowrank mid 投影（fp32 权重），一次 dispatch。
//   r = xr @ R^T；k = xk @ K^T；v = xv @ V^T
//   v_mid = xv @ V1；w_mid = tanh(xw @ W1)；a_mid = xa @ A1；g_mid = xg @ G1
//
// 权重布局同 `gemv_int6.comp`（N-major 双平面，见该文件头）。**一个 invocation 一个输出列**：
// 相邻 invocation 覆盖相邻 row ⇒ 字节载入天然合并，且每个 invocation 自带完整点积
//（无需跨线程归约，求和顺序固定 ⇒ 贪心 token 流可复现）。
//
// dispatch = (ceil((C + VM + WM + AM + GM) / BLOCK_SIZE), 1, 1)：
//   前 C 个 invocation 各算一行 r/k/v；其后 VM+WM+AM+GM 个各算一行 mid 投影。
// 要求 C % 64 == 0（int6 打包块）。

layout(constant_id = 0) const uint C  = 2560;
layout(constant_id = 1) const uint VM = 64;
layout(constant_id = 2) const uint WM = 96;
layout(constant_id = 3) const uint AM = 96;
layout(constant_id = 4) const uint GM = 320;

const uint BLOCK_SIZE = 128;
const uint NCHUNK     = C / 64;

layout(buffer_reference) buffer InLo  { uint data[]; };
layout(buffer_reference) buffer InHi  { uint data[]; };
layout(buffer_reference) buffer InSZ  { uint data[]; };
layout(buffer_reference) buffer InF32 { float data[]; };
layout(buffer_reference) buffer InF16 { float16_t data[]; };

layout(set = 0, binding = 0, std430) uniform Params {
    InLo  r_lo;
    InHi  r_hi;
    InSZ  r_sz;
    InLo  k_lo;
    InHi  k_hi;
    InSZ  k_sz;
    InLo  v_lo;
    InHi  v_hi;
    InSZ  v_sz;
    InF32 v1;
    InF32 w1;
    InF32 a1;
    InF32 g1;
    InF32 xr;
    InF32 xk;
    InF32 xv;
    InF32 xw;
    InF32 xa;
    InF32 xg;
    InF32 out_r;
    InF32 out_k;
    InF16 out_v;
    InF32 out_vm;
    InF32 out_wm;
    InF32 out_am;
    InF32 out_gm;
} params;

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

uint byte_at(InLo p, uint byte_index) {
    return (p.data[byte_index >> 2] >> ((byte_index & 3u) * 8u)) & 0xFFu;
}

// 单列 row 在 N-major 双平面上的完整点积（K = C）
float dot_nm(InLo lo, InHi hi, InSZ sz, InF32 x, uint row) {
    float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
    for (uint c = 0; c < NCHUNK; ++c) {
        const float sc = unpackHalf2x16(sz.data[(c >> 1) * C + row]).x;
        const uint lo0 = c * 32u;
        const uint hi0 = c * 16u;
        const uint kb  = c * 64u;
        [[unroll]]
        for (uint j = 0; j < 16u; ++j) {
            const uint lb0 = byte_at(lo, (lo0 + j) * C + row);
            const uint lb1 = byte_at(lo, (lo0 + 16u + j) * C + row);
            const uint hb  = byte_at(hi, (hi0 + j) * C + row);
            const int e0 = int(lb0 & 15u) | (int(hb & 3u) << 4);
            const int e1 = int(lb1 & 15u) | (int((hb >> 2) & 3u) << 4);
            const int e2 = int(lb0 >> 4) | (int((hb >> 4) & 3u) << 4);
            const int e3 = int(lb1 >> 4) | (int((hb >> 6) & 3u) << 4);
            a0 += sc * float(e0 - 32) * x.data[kb + j];
            a1 += sc * float(e1 - 32) * x.data[kb + 16u + j];
            a2 += sc * float(e2 - 32) * x.data[kb + 32u + j];
            a3 += sc * float(e3 - 32) * x.data[kb + 48u + j];
        }
    }
    return (a0 + a1) + (a2 + a3);
}

// mid 投影：fp32 权重 [rows, C] 行主序 × x[C]
float dot_f32(InF32 w, InF32 x, uint row) {
    float d = 0.0;
    const uint base = row * C;
    for (uint k = 0; k < C; ++k) d += w.data[base + k] * x.data[k];
    return d;
}

void main() {
    const uint gi   = gl_WorkGroupID.x * BLOCK_SIZE + gl_LocalInvocationIndex;
    const uint midt = VM + WM + AM + GM;

    if (gi < C) {
        params.out_r.data[gi] = dot_nm(params.r_lo, params.r_hi, params.r_sz, params.xr, gi);
        params.out_k.data[gi] = dot_nm(params.k_lo, params.k_hi, params.k_sz, params.xk, gi);
        params.out_v.data[gi] = float16_t(dot_nm(params.v_lo, params.v_hi, params.v_sz, params.xv, gi));
        return;
    }

    const uint m = gi - C;
    if (m >= midt) return;
    if (m < VM) {
        params.out_vm.data[m] = dot_f32(params.v1, params.xv, m);
    } else if (m < VM + WM) {
        params.out_wm.data[m - VM] = tanh(dot_f32(params.w1, params.xw, m - VM));
    } else if (m < VM + WM + AM) {
        params.out_am.data[m - VM - WM] = dot_f32(params.a1, params.xa, m - VM - WM);
    } else {
        params.out_gm.data[m - VM - WM - AM] = dot_f32(params.g1, params.xg, m - VM - WM - AM);
    }
}
