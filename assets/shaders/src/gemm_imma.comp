#version 450 core
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_cooperative_matrix : require

// int8 张量核批量 GEMM（W8A8）：`y = op(xq @ W^T)`
//   - W：int8 非对称分组量化（组宽 128）：`w = s[m,g]·q_u + z[m,g]`，`q_u ∈ [0,255]`；
//   - x：int8 对称分组量化（`quant_x_i8.comp`）：`x = sx[b,g]·q`，`q ∈ [-127,127]`，
//        并给出每组的 `xaux = (sx, 128·sx·Σq, Σx, 0)`。
//
// ★ 与 CUDA `imma_gemm_batch`（backend_cuda.rs:5490）**同构**：IMMA 只吃 s8 ⇒ 权重落 smem 时
//   `byte ^ 0x80` 下移到有符号域，组末按
//   `y += s[m,g]·(sx·S + 128·sx·Σq) + z[m,g]·Σx`（S = 张量核的 int32 结果）一次性还原。
//   组宽 128 与量化组对齐 ⇒ **每个 k-tile 恰好是一组**，flush 天然落在 tile 末尾。
//
// ★ 权重索引缓冲 `in_idx` 的**设备布局 = 组主序 `[K/128][M][32 uint]`**（模型文件仍是行主序
//   `[M][K/4]`，置换在上传时由 `backend::int8_idx_to_group_major` 做，开关 =
//   `ComputeBackend::int8_idx_group_major`）。原因：本 kernel 小批量档的耗时 100 % 在权重的
//   全局载入流上，而 achieved 带宽由「时间上相邻地址的连续段长度」决定 —— 行主序下一个 warp
//   指令只能凑到 128 B（一行的一组 = 32 个 uint），换组要跳 `K4` 个字；组主序下同一 block 的
//   `BM` 行在同一组内**首尾相接**，连续段与整行等价。同会话探针实测（字节集合、smem、warp 数、
//   mma 数全同，只改地址时序）：head −24 %、key/value −18…19 %（B=1…16）。
//   ⇒ 权重读地址一律 `gr * (M*32) + row * 32 + (i & 31)`；激活 `in_xq` **不变**（仍是
//   `[batch][K/4]` 行主序，它不是带宽瓶颈）。
//
// 布局：block = `(BM/16)·SW·32` 线程（每 warp 一个 16×8 int32 输出块，coopmat m16n8k32；
//   行维 `RW=BM/16` 个 warp，槽组维 `SW=min(NST,2)` 个 warp，见下方 `SW` 的注释）。
//   - 行：`grid.x = M/IM_BM`，每 block IM_BM 行；
//   - 槽：每 block 覆盖 `BN·NST = 8·IM_NST` 个槽（`grid.z = ceil(batch / (8·IM_NST))`）
//     —— **权重每个 k-tile 只载一次，组内循环 NST 次复用**（对齐 CUDA 的 `NST`）。
//     这是大 batch 的关键：只覆盖 8 槽时权重会被 `batch/8` 重读，聚合吞吐几乎不随 batch 涨。
//   - k：`grid.y = KS`（split-K 分块数），各段只写部分和，由 `gemm_imma_reduce` 求和。
//
// `IM_BM` / `IM_NST` 决定 `local_size_x` 与循环上界，必须走构建期 define ⇒ 每个组合一份 spv
// （`gemm_imma_bm{64,128}_nst{1,2,4,8,16}.spv`）。
//
// `OP`（特化常量 3）决定 epilogue：
//   0 = relu² 覆盖写（ffn.key）
//   1 = 累加到 y（ffn.value 的 `x += r2@Wv^T`、att.output 的 `x += (y_norm·g)@Wo^T`）
//   2 = 覆盖写（head 的 logits）
//   9 / 10 = **诊断**：把 smem 里 staging 好的权重 / 激活字节原样写回（`examples/imma_probe.rs`
//             用它定位过三处索引 bug；正常路径不用）。
// att.output 的 `·g` 门控在**量化激活**那一步做掉（`quant_x_i8.comp` 的 `HAS_G`），
// 与 CUDA 把 `gd` 交给 `quant_x_i8` 的做法一致。

#ifndef IM_BM
#define IM_BM 64
#endif
#ifndef IM_NST
#define IM_NST 1
#endif
// 宽窗口档开关：只有 `BM=16` 采用「沿 k 分组」的 staging；其余档**文本上保持原结构**
// （⇒ `gemm_imma_bm64/128_*.spv` 与改造前逐字节相同，大 batch 那条已量化的曲线不受影响）。
#define IM_WIDE (IM_BM == 16)

layout(constant_id = 0) const uint M     = 10240;  // 输出行数
layout(constant_id = 1) const uint K     = 2560;   // 收缩维（须为 128 整除）
layout(constant_id = 2) const uint BATCH = 8;      // 槽位数
layout(constant_id = 3) const uint OP    = 0;      // epilogue 见文件头
layout(constant_id = 4) const uint KS    = 1;      // split-K 分块数（grid.y = ksp）

const uint BM   = IM_BM;    // 每 block 的输出行数
const uint NST  = IM_NST;   // 每 block 的 slot 组数（每组 BN = 8 槽）
const uint BN   = 8;        // coopmat 的 N
const uint SLOT = BN * NST; // 每 block 覆盖的槽数
const uint BK   = 128;      // k 分块 = 量化组宽（flush 粒度与之对齐）
// ★ 2026-10-11 **小批量档的 k 窗口宽度**（`BM=16` 档 = 宽窗口档）。
//   实测（同会话、`VK_SPV_DIR` 换 spv、纯读探针：字节集合/grid/指令条数全同，只改每 warp 的
//   **地址顺序**）：连续段 128 B ⇒ 408 GB/s，512 B ⇒ 563，2560 B ⇒ 565；而 SIMT 平坦核
//   在同形状上 558 GB/s。⇒ 旧结构每个 k-tile「读 128 B 就换行」让 DRAM 页反复重开，
//   小批量档 `gemm_imma` 的时间差**全部**来自这里（删光 mma/flush 时间不变，见记录 §六）。
//   窗口变宽用 `BM` 变小付账：`BM×BKW` 与旧的 `64×BK` 同量级 ⇒ smem/占用不塌。
//   `NGW = 1` 的档（`BM=64/128`）保持原结构：大 batch 是算力受限的，宽窗口只会多占 smem。
#if IM_WIDE
const uint BKW  = 512u;  // 一次 staging 覆盖的 k 字节数
#else
const uint BKW  = BK;
#endif
const uint NGW  = BKW / BK;                 // 每窗口的量化组数（= 1 时完全等于旧行为）
const uint WS   = BKW + 16;  // smem 行跨距（字节）：+16 让行首错开 4 个 bank
const uint WPU  = WS / 4u;   // 同一跨距按 **uint** 计（smem 是 packed 的，见下方声明）
const uint WR   = 16;       // 每 warp 的输出行数（coopmat 的 M）
const uint RW   = BM / WR;  // 行 warp 数
// ★ 2026-10-11：槽组也分到 warp（`SW`），每 warp 只跑 `RPG = NST/SW` 组。
//   动机：旧布局 `BM*2` 线程 = RW 个 warp，一个 warp 要把 NST=8 组全跑完 ⇒
//   `acc[8][4]` = 32 个累加寄存器 + 4 份 A 片段，块内只有 4 个 warp 掩盖延迟。
//   分一半槽组给第二批 warp 后：累加器减半、warp 数翻倍、每 warp 的 smem 取数指令减半
//   （A 片段仍在自己的 4 份寄存器里复用）。`BM=128` 档已经有 8 个行 warp，不再拆。
//   （写成三元而不是 `min()`：`BLOCK_SIZE` 要进 `layout(local_size_x=…)`，必须是常量表达式。）
const uint SW   = (BM == 64u) ? (NST < 2u ? NST : 2u) : 1u;
const uint RPG  = NST / SW; // 每 warp 的槽组数
const uint BLOCK_SIZE = RW * SW * 32u;
const uint NLD  = BM * 32u / BLOCK_SIZE;                        // 每线程·每组 的权重载入条数
const uint NW   = NLD * NGW;                                    // 每线程·每窗口 的权重载入条数
const uint CH   = (NW < 16u) ? NW : 16u;                        // 同时在飞的载入条数（寄存器预算）
const uint XW   = SLOT * 32u;                                   // 每组（BK=128）的激活字数
const uint NLDX = (XW + BLOCK_SIZE - 1u) / BLOCK_SIZE;          // 每线程·每组 的激活载入条数

layout(buffer_reference) buffer WIdx { uint data[]; };    // int8 权重 [M, K/4]（4 个 uint8/uint32）
layout(buffer_reference) buffer WSz  { uint data[]; };    // fp16(尺度|零点) [M, K/128]
layout(buffer_reference) buffer XQ   { uint data[]; };    // 量化激活 [batch, K/4]
layout(buffer_reference) buffer XAux { vec4 data[]; };    // 每 (槽, 组) 统计 [batch, K/128]
layout(buffer_reference) buffer OutY { float data[]; };   // [batch, M]（或 split-K 的部分和）
layout(buffer_reference) buffer Out16 { float16_t data[]; }; // fp16 视图（OP=3：v 链输出）

layout(set = 0, binding = 0, std430) uniform Params {
    WIdx  in_idx;
    WSz   in_sz;
    XQ    in_xq;
    XAux  in_aux;
    OutY  out_y;
    Out16 out16;
} params;

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

/// smem 按 **uint** 存（4 个 int8 打包进一个 uint），不是按字节：
///   - 落盘：一条 `STS.u32` 替掉 4 条 `STS.u8`。这是本 kernel 的**主瓶颈**——BM=64/NST=8 档
///     每 block 每 k-tile 要落 `(BM + SLOT)·BK` = 16 KiB，旧写法 = 512 条 warp 级 STS，
///     而同期只有 128 条 mma；`VK_IMMA_NST` 扫描的实测曲线（NST 2→8 慢 2.07×，正比于
///     每槽摊到的落盘字节）也指向同一结论。
///   - 读回：coopmat 的 int8 片段每 lane 正好 4 个连续字节 ⇒ 一条 `LDS.u32`。
///   GLSL 允许 8 位矩阵从 32 位标量数组打包载入，此时 `stride`/`offset` 按 uint 计。
shared uint ws[BM * WPU];               // 本 k-tile 的权重（已 ^0x80）
shared uint xs[SLOT * WPU];             // 本 k-tile 的激活（有符号 int8，全部 NST 组一次落盘）
shared int    tile[RW * SW][WR * BN];   // 每 warp 的 int32 累加块（coopMatStore 落地）
                                        // 第一维 = 本档的 warp 数（写成字面量 8 会在
                                        // `SW` 提到 4 时静默越界 ⇒ 由构造绑定 `RW*SW`）
shared uint   szs[BM * NGW];            // 本窗口的权重尺度/零点（每行 × 每组一份）
shared vec4   xas[SLOT * NGW];          // 本窗口的激活统计（每槽 × 每组一份）

/// 取 packed smem 里第 `byte` 个字节并**按 int8 符号扩展**（只服务 OP=9/10 诊断路径）。
/// 写成宏而不是函数：GLSL 的数组形参必须带尺寸，而 `ws`/`xs` 的尺寸按档位不同。
#define PACKED_BYTE(arr, byte) \
    int(int8_t(((arr)[(byte) >> 2u] >> (8u * ((byte) & 3u))) & 0xFFu))

void main() {
    const uint index = gl_LocalInvocationIndex;
    const uint wid   = gl_LocalInvocationIndex >> 5u;   // warp 号（行维 × 槽组维 的二维）
    const uint lane  = gl_SubgroupInvocationID;
    // `row_warp` 选输出行块（每 warp 16 行），`slot_warp` 选槽组段（每 warp RPG 组）。
    const uint row_warp  = wid % RW;
    const uint slot_warp = wid / RW;

    const uint row0   = gl_WorkGroupID.x * BM;
    const uint s0base = gl_WorkGroupID.z * SLOT;        // 本 block 负责的首个槽号
    const uint K4     = K >> 2;
    const uint G      = K >> 7;

    // 每 lane 负责 4 个输出元素：槽（col）= lane % 8 固定，行 = lane/8 + 4i
    const uint fcol = lane & 7u;
    const uint frow = lane >> 3u;   // 0..3 → 行 = frow, frow+4, frow+8, frow+12

    // 每 lane 持有**本 warp 的** RPG 组 × 4 个输出元素
    float acc[RPG][4];
    [[unroll]]
    for (uint gg = 0u; gg < RPG; gg++) {
        [[unroll]]
        for (uint i = 0u; i < 4u; i++) acc[gg][i] = 0.0;
    }

    coopmat<int32_t, gl_ScopeSubgroup, WR, BN, gl_MatrixUseAccumulator> ci;
    coopmat<int8_t,  gl_ScopeSubgroup, 32, BN, gl_MatrixUseB> xf;
    // A 片段（权重 m16k32 i8）在本 k-tile 内被全部 NST 组复用 ⇒ 提到组循环**外面**只载一次。
    // 旧写法在组循环里做 `coopMatLoad(cf)` ⇒ 每 k-tile 每 warp 发 NST×4 次 smem 载入
    // （一份 A 片段 = 16 B/lane ≈ 4 条 LDS），而 mma 也只有 4×NST 条 ⇒ **取数指令比 mma 还多**。
    coopmat<int8_t, gl_ScopeSubgroup, WR, 32, gl_MatrixUseA> a0, a1, a2, a3;

    // split-K：本 block 负责的 k 区间（host 保证 `K/128 % KS == 0`，段按量化组对齐）
    const uint ksp = gl_WorkGroupID.y;
    const uint kb  = K / KS;

    for (uint kt = ksp * kb; kt < (ksp + 1u) * kb; kt += BKW) {
        const uint gr = kt >> 7u;   // 组号（宽窗口档：本窗口的**首个**量化组）

        // —— 落 smem（每个 k 窗口一次）：权重 + **全部 NST 组**的激活 + 本组统计 ——
        // ★ 关键：**先把全部全局载入取到寄存器，再统一落 smem**：本 kernel 的块数有限，
        //   没有第二个 block 帮忙掩盖延迟；若「LDG → STS」逐对发出，每对都要等一次
        //   ~600 cycle 的全局延迟。寄存器预取后所有载入并发在飞。
#if IM_WIDE
        // 宽窗口档（`BM=16` ⇒ `BKW=512`）：**沿 k 走**的分组 staging。同一行连续读 `NGW`
        // 个组 = `BKW` 字节的连续段（128 B 段 408 GB/s vs 512 B 段 563，见 `BKW` 注释）。
        // ⚠️ 外层 `cg` **不能** `[[unroll]]`：一 unroll 就是把 `NW` 条载入全钉在寄存器上
        //    （本档 `NW=64` ⇒ 必然溢出到本地内存，比旧结构更慢）。
        uint wr[CH];
        for (uint cg = 0u; cg < NW; cg += CH) {
            [[unroll]]
            for (uint t = 0u; t < CH; t++) {
                const uint c = cg + t;
                const uint i = index + (c / NGW) * BLOCK_SIZE;
                const uint s = c % NGW;
                const uint src = min(row0 + (i >> 5u), M - 1u);
                wr[t] = params.in_idx.data[(gr + s) * (M * 32u) + src * 32u + (i & 31u)];
            }
            [[unroll]]
            for (uint t = 0u; t < CH; t++) {
                const uint c = cg + t;
                const uint i = index + (c / NGW) * BLOCK_SIZE;
                const uint s = c % NGW;
                ws[(i >> 5u) * WPU + s * 32u + (i & 31u)] = wr[t] ^ 0x80808080u;
            }
        }
        [[unroll]]
        for (uint s = 0u; s < NGW; s++) {
            uint xr[NLDX];
            [[unroll]]
            for (uint n = 0u; n < NLDX; n++) {
                const uint i = index + n * BLOCK_SIZE;
                if (i < XW && s0base + (i >> 5u) < BATCH) {
                    xr[n] = params.in_xq.data[(s0base + (i >> 5u)) * K4 + (kt >> 2u) + s * 32u + (i & 31u)];
                }
            }
            [[unroll]]
            for (uint n = 0u; n < NLDX; n++) {
                const uint i = index + n * BLOCK_SIZE;
                // 激活：写 `xs` 不是 `ws`（2026-10-04 曾误写权重数组 ⇒ B 恒为 0）。
                if (i < XW && s0base + (i >> 5u) < BATCH) {
                    xs[(i >> 5u) * WPU + s * 32u + (i & 31u)] = xr[n];
                }
            }
            if (index < BM) {
                const uint src = min(row0 + index, M - 1u);
                szs[s * BM + index] = params.in_sz.data[src * G + gr + s];
            }
            if (index < SLOT && s0base + index < BATCH) {
                xas[s * SLOT + index] = params.in_aux.data[(s0base + index) * G + gr + s];
            }
        }
#else
        uint wr[NLD];
        [[unroll]]
        for (uint n = 0u; n < NLD; n++) {
            const uint i = index + n * BLOCK_SIZE;
            const uint src = min(row0 + (i >> 5u), M - 1u);
            wr[n] = params.in_idx.data[gr * (M * 32u) + src * 32u + (i & 31u)];
        }
        uint xr[NLDX];
        [[unroll]]
        for (uint n = 0u; n < NLDX; n++) {
            const uint i = index + n * BLOCK_SIZE;
            if (i < XW && s0base + (i >> 5u) < BATCH) {
                xr[n] = params.in_xq.data[(s0base + (i >> 5u)) * K4 + (kt >> 2u) + (i & 31u)];
            }
        }
        [[unroll]]
        for (uint n = 0u; n < NLD; n++) {
            const uint i = index + n * BLOCK_SIZE;
            // 权重：整字 ^0x80 下移到有符号域（与 CUDA IMMA 只吃 s8 一致）。
            ws[(i >> 5u) * WPU + (i & 31u)] = wr[n] ^ 0x80808080u;
        }
        [[unroll]]
        for (uint n = 0u; n < NLDX; n++) {
            const uint i = index + n * BLOCK_SIZE;
            // 激活：写 `xs` 不是 `ws`（2026-10-04 曾误写权重数组 ⇒ B 恒为 0）。
            if (i < XW && s0base + (i >> 5u) < BATCH) {
                xs[(i >> 5u) * WPU + (i & 31u)] = xr[n];
            }
        }
        if (index < BM) {
            const uint src = min(row0 + index, M - 1u);
            szs[index] = params.in_sz.data[src * G + gr];
        }
        if (index < SLOT && s0base + index < BATCH) {
            xas[index] = params.in_aux.data[(s0base + index) * G + gr];
        }
#endif
        barrier();  // (1) staging 完成

        // —— 逐量化组推进窗口（`NGW==1` 时就是这个循环只转一圈 = 旧行为）——
        // 权重片段先载进寄存器、本组内被全部 NST 组复用；组序**升序** ⇒ 与旧结构逐位同序。
        [[unroll]]
        for (uint s = 0u; s < NGW; s++) {
            // 偏移 0/8/16/24 = 一个 32 字节 k 切片 = 8 个 uint。
            const uint wrow = (row_warp * WR) * WPU + s * 32u;
            coopMatLoad(a0, ws, wrow + 0u, WPU, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(a1, ws, wrow + 8u, WPU, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(a2, ws, wrow + 16u, WPU, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(a3, ws, wrow + 24u, WPU, gl_CooperativeMatrixLayoutRowMajor);

            // —— 逐 slot 组复用同一份权重（本 warp 只跑 `slot_warp` 那一段）——
            [[unroll]]
            for (uint gg = 0u; gg < RPG; gg++) {
                const uint g = slot_warp * RPG + gg;   // block 内的全局槽组号（xs/xas 用它）
                ci = coopmat<int32_t, gl_ScopeSubgroup, WR, BN, gl_MatrixUseAccumulator>(0);

                // 4 次 mma（本组 K = 128 = 4 × 32）；B：激活 k×槽
                // （ColMajor：(k,s) 在 xs[(g*BN+s)*WPU + ks*8 + k/4]）
                const uint xrow = (g * BN) * WPU + s * 32u;
                coopMatLoad(xf, xs, xrow + 0u, WPU, gl_CooperativeMatrixLayoutColumnMajor);
                ci = coopMatMulAdd(a0, xf, ci);
                coopMatLoad(xf, xs, xrow + 8u, WPU, gl_CooperativeMatrixLayoutColumnMajor);
                ci = coopMatMulAdd(a1, xf, ci);
                coopMatLoad(xf, xs, xrow + 16u, WPU, gl_CooperativeMatrixLayoutColumnMajor);
                ci = coopMatMulAdd(a2, xf, ci);
                coopMatLoad(xf, xs, xrow + 24u, WPU, gl_CooperativeMatrixLayoutColumnMajor);
                ci = coopMatMulAdd(a3, xf, ci);

                // flush：int32 → fp32 尺度还原 + 零点修正
                // ⚠️ `tile[wid]` 是**本 warp 私有**的（每 warp 只读写自己那一片），故组间同步
                //    只需 subgroup 级；跨 warp 的 `ws`/`xs` 复用由 k 窗口末尾的 barrier 兜住。
                coopMatStore(ci, tile[wid], 0u, BN, gl_CooperativeMatrixLayoutRowMajor);
                subgroupBarrier();
                [[unroll]]
                for (uint i = 0u; i < 4u; i++) {
                    // `r` 是**本 warp 的局部行号**（tile[wid] 只有 WR 行）⇒ 取 szs 要加行基址。
                    const uint r = frow + i * 4u;
                    const int32_t S = tile[wid][r * BN + fcol];
                    const vec2 szv = unpackFloat2x16(szs[s * BM + row_warp * WR + r]);
                    const vec4 au = xas[s * SLOT + g * BN + fcol];
                    acc[gg][i] += szv.x * (au.x * float(S) + au.y) + szv.y * au.z;
                }
                subgroupBarrier();
            }
        }
        barrier();  // (2) 所有 warp 读完 ws/xs 后才允许下一轮 staging
    }

    // —— epilogue：按 OP 施加激活/累加 + 写回 ——
    // ⚠️ `slot` 可能 ≥ BATCH（最后一个 slot 块不满）⇒ 必须逐槽守卫。
    // ⚠️ 行号必须带上 **本 warp 的行基址 `row_warp * WR`**（flush 里 `tile[wid][r*BN]` 的 `r` 是
    //    warp 内局部行号）。漏掉它 ⇒ 多个 warp 全部写 `[row0, row0+16)` 同一批行上互相覆盖，
    //    结果既是错的、又是**竞态的**（2026-10-04 实测：同配置两跑 token 指纹不同）。
    [[unroll]]
    for (uint gg = 0u; gg < RPG; gg++) {
        const uint g = slot_warp * RPG + gg;
        const uint slot = s0base + g * BN + fcol;
        if (slot >= BATCH) continue;
        [[unroll]]
        for (uint i = 0u; i < 4u; i++) {
            const uint r = row0 + row_warp * WR + frow + i * 4u;
            if (r < M) {
                const uint o = slot * M + r;
                if (KS > 1u) {
                    // split-K：各段只写**部分和**到 `out_y + ksp*BATCH*M`（布局 [KS][BATCH][M]），
                    // 不施加 op、不读旧值 —— op 与求和交给 `gemm_imma_reduce`（固定顺序 ⇒ 确定性）。
                    params.out_y.data[ksp * BATCH * M + o] = acc[gg][i];
                } else if (OP == 9u) {
                    // 诊断：直读 smem 的权重字节（`ws[(行, k=fcol)]`）——验证 staging + 行映射
                    params.out_y.data[o] = float(PACKED_BYTE(ws, (row_warp * WR + frow + i * 4u) * WS + fcol));
                } else if (OP == 10u) {
                    // 诊断：直读 smem 的激活字节（`xs[(组内槽=fcol, k)]`）
                    params.out_y.data[o] = float(PACKED_BYTE(xs, (g * BN + fcol) * WS + (frow + i * 4u)));
                } else if (OP == 3u) {
                    // 覆盖写、但落 fp16（v 链的输出张量本就是 fp16 语义；舍入与 `float16_t`
                    // 一致，与旧的 SIMT 路径 `float16_t(res)` 逐位相同）
                    params.out16.data[o] = float16_t(acc[gg][i]);
                } else if (OP == 1u) {
                    params.out_y.data[o] = params.out_y.data[o] + acc[gg][i];
                } else {
                    const float v = acc[gg][i];
                    params.out_y.data[o] = (OP == 0u) ? (v > 0.0 ? v * v : 0.0) : v;
                }
            }
        }
    }
}
