#version 450 core
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable

// split-K 版 coopmat fp16 GEMM（`gemm.comp` 的窄形状兄弟，专供低秩链一级的四条 4/8/20 块臂）。
//
// 与 `gemm.comp` 的差别只有三处，其余逐行一致（常量号也保持同一套，host 侧直接复用
// `gemm_spec` 的 42 个槽）：
//   ① 多了 constant_id=42 `SPLIT_K`：`grid.z = batch × SPLIT_K`，本块只算 K 的第
//      `gl_WorkGroupID.z % SPLIT_K` 段（K 循环按 tile_k 平移，段长 = NUM_TILE_K / SPLIT_K）。
//   ② 输出**不施加激活/残差**，写进 `partial[SPLIT_K][M][N]`（`STRIDE_C_BATCH` 由 host 填
//      M×N，槽号用 `gl_WorkGroupID.z` 原值）——沿 k 的部分和必须由配套归约内核按 ks **升序**
//      相加，否则 tanh/sigmoid 会作用在部分和上（那就不是同一条式子了）。
//   ③ 类型写死 fp16 进 / fp32 出（低秩一级只需要这一档，省掉 build.rs 的变体矩阵）。
//
// 动机是**占用**，不是算术：一级四条链的 N 只有 64/128/320，`(64,32,64)` 瓦片下 grid 只有
// 4/8/20 块，喂不满 68 个 SM，而 K=2560 全在一块里串行（记录 §11.3 / §11.6——B=64 打平、
// B=32 净亏就是这个饥饿的直接后果）。加块唯一手段就是把 K 切开。
// ⚠️ 切分必须整除：`NUM_TILE_K % SPLIT_K == 0`，否则尾 k-tile 静默丢失（只由 `sum(y)`
//    类指纹才看得见，见 `gemm_tile_for` 里同一条教训）。

#define A_BITS 16
#define A_TYPE float16_t
#define C_BITS 32
#define C_TYPE float32_t

layout(constant_id = 0) const uint MAT_M = 16;
layout(constant_id = 1) const uint MAT_N = 16;
layout(constant_id = 2) const uint MAT_K = 16;

layout(constant_id = 3) const uint TILE_M = 256;
layout(constant_id = 4) const uint TILE_N = 256;
layout(constant_id = 5) const uint TILE_K = 64;

layout(constant_id = 6) const uint M = 4096;
layout(constant_id = 7) const uint N = 4096;
layout(constant_id = 8) const uint K = 4096;

layout(constant_id = 9)  const uint STRIDE_A_TILE_X = 1;
layout(constant_id = 10) const uint STRIDE_A_TILE_Y = 4096;
layout(constant_id = 11) const uint STRIDE_A_TILE_Z = 32;
layout(constant_id = 12) const uint STRIDE_A_TILE_W = 1048576;

layout(constant_id = 13) const uint STRIDE_B_TILE_X = 1;
layout(constant_id = 14) const uint STRIDE_B_TILE_Y = 4096;
layout(constant_id = 15) const uint STRIDE_B_TILE_Z = 32;
layout(constant_id = 16) const uint STRIDE_B_TILE_W = 1048576;

layout(constant_id = 17) const uint STRIDE_SH_A_TILE_X = 1;
layout(constant_id = 18) const uint STRIDE_SH_A_TILE_Y = 40;
layout(constant_id = 19) const uint STRIDE_SH_B_TILE_X = 1;
layout(constant_id = 20) const uint STRIDE_SH_B_TILE_Y = 40;

layout(constant_id = 21) const uint STRIDE_SH_A_MAT_X = 1;
layout(constant_id = 22) const uint STRIDE_SH_A_MAT_Y = 40;

layout(constant_id = 23) const uint STRIDE_SH_A_SUBTILE_X = 16;
layout(constant_id = 24) const uint STRIDE_SH_A_SUBTILE_Y = 640;
layout(constant_id = 25) const uint STRIDE_SH_A_SUBTILE_Z = 2560;

layout(constant_id = 26) const uint STRIDE_SH_B_MAT_X = 1;
layout(constant_id = 27) const uint STRIDE_SH_B_MAT_Y = 40;

layout(constant_id = 28) const uint STRIDE_SH_B_SUBTILE_X = 16;
layout(constant_id = 29) const uint STRIDE_SH_B_SUBTILE_Y = 640;
layout(constant_id = 30) const uint STRIDE_SH_B_SUBTILE_Z = 5120;

layout(constant_id = 31) const uint STRIDE_C_SUBTILE_X = 1;
layout(constant_id = 32) const uint STRIDE_C_SUBTILE_Y = 4096;
layout(constant_id = 33) const uint STRIDE_C_SUBTILE_Z = 16;
layout(constant_id = 34) const uint STRIDE_C_SUBTILE_W = 65536;

layout(constant_id = 35) const uint STRIDE_C_TILE_X = 64;
layout(constant_id = 36) const uint STRIDE_C_TILE_Y = 524288;
layout(constant_id = 37) const uint STRIDE_C_TILE_Z = 256;
layout(constant_id = 38) const uint STRIDE_C_TILE_W = 1048576;

layout(constant_id = 39) const uint STRIDE_A_BATCH = 0;
layout(constant_id = 40) const uint STRIDE_B_BATCH = 0;
layout(constant_id = 41) const uint STRIDE_C_BATCH = 0;

// ★ 本文件独有：k 方向的分块数（host 侧必须保证 NUM_TILE_K % SPLIT_K == 0）。
layout(constant_id = 42) const uint SPLIT_K = 1;

const uint A_BYTES              = A_BITS / 8;

const uint NUM_ELEMENT_VEC4     = 16 / A_BYTES;

const uint NUM_SUBTILE_TILE_M   = 4;
const uint NUM_SUBTILE_TILE_N   = 2;
const uint NUM_SUBTILE_TILE     = NUM_SUBTILE_TILE_M * NUM_SUBTILE_TILE_N;
const uint NUM_INVOKE_SUBTILE   = 32;
const uint NUM_INVOKE_TILE      = NUM_INVOKE_SUBTILE * NUM_SUBTILE_TILE;

const uint SUBTILE_M            = TILE_M / NUM_SUBTILE_TILE_M;
const uint SUBTILE_N            = TILE_N / NUM_SUBTILE_TILE_N;
const uint SUBTILE_K            = TILE_K;

const uint NUM_MAT_SUBTILE_M    = SUBTILE_M / MAT_M;
const uint NUM_MAT_SUBTILE_N    = SUBTILE_N / MAT_N;
const uint NUM_MAT_SUBTILE_K    = SUBTILE_K / MAT_K;

const uint NUM_TILE_M           = M / TILE_M;
const uint NUM_TILE_N           = N / TILE_N;
const uint NUM_TILE_K           = K / TILE_K;
const uint CHUNK_TILE_K         = NUM_TILE_K / SPLIT_K;

const uvec4 SHAPE_A_TILE        = uvec4(TILE_K, TILE_M, NUM_TILE_K, NUM_TILE_M);
const uvec4 SHAPE_B_TILE        = uvec4(TILE_K, TILE_N, NUM_TILE_K, NUM_TILE_N);

const uvec4 STRIDE_A_TILE       = uvec4(STRIDE_A_TILE_X, STRIDE_A_TILE_Y, STRIDE_A_TILE_Z, STRIDE_A_TILE_W);
const uvec4 STRIDE_B_TILE       = uvec4(STRIDE_B_TILE_X, STRIDE_B_TILE_Y, STRIDE_B_TILE_Z, STRIDE_B_TILE_W);

const uvec2 SHAPE_SH_A_TILE     = uvec2(TILE_K, TILE_M);
const uvec2 SHAPE_SH_B_TILE     = uvec2(TILE_K, TILE_N);

const uvec2 STRIDE_SH_A_TILE    = uvec2(STRIDE_SH_A_TILE_X, STRIDE_SH_A_TILE_Y);
const uvec2 STRIDE_SH_B_TILE    = uvec2(STRIDE_SH_B_TILE_X, STRIDE_SH_B_TILE_Y);

const uvec2 SHAPE_SH_A_MAT      = uvec2(MAT_K, MAT_M);
const uvec2 STRIDE_SH_A_MAT     = uvec2(STRIDE_SH_A_MAT_X, STRIDE_SH_A_MAT_Y);

const uvec3 SHAPE_SH_A_SUBTILE  = uvec3(NUM_MAT_SUBTILE_K, NUM_MAT_SUBTILE_M, NUM_SUBTILE_TILE_M);
const uvec3 STRIDE_SH_A_SUBTILE = uvec3(STRIDE_SH_A_SUBTILE_X, STRIDE_SH_A_SUBTILE_Y, STRIDE_SH_A_SUBTILE_Z);

const uvec2 SHAPE_SH_B_MAT      = uvec2(MAT_K, MAT_N);
const uvec2 STRIDE_SH_B_MAT     = uvec2(STRIDE_SH_B_MAT_X, STRIDE_SH_B_MAT_Y);

const uvec3 SHAPE_SH_B_SUBTILE  = uvec3(NUM_MAT_SUBTILE_K, NUM_MAT_SUBTILE_N, NUM_SUBTILE_TILE_N);
const uvec3 STRIDE_SH_B_SUBTILE = uvec3(STRIDE_SH_B_SUBTILE_X, STRIDE_SH_B_SUBTILE_Y, STRIDE_SH_B_SUBTILE_Z);

const uvec4 SHAPE_C_SUBTILE     = uvec4(MAT_M, MAT_N, NUM_MAT_SUBTILE_M, NUM_MAT_SUBTILE_N);
const uvec4 STRIDE_C_SUBTILE    = uvec4(STRIDE_C_SUBTILE_X, STRIDE_C_SUBTILE_Y, STRIDE_C_SUBTILE_Z, STRIDE_C_SUBTILE_W);

const uvec4 SHAPE_C_TILE        = uvec4(NUM_SUBTILE_TILE_M, NUM_SUBTILE_TILE_N, NUM_TILE_M, NUM_TILE_N);
const uvec4 STRIDE_C_TILE       = uvec4(STRIDE_C_TILE_X, STRIDE_C_TILE_Y, STRIDE_C_TILE_Z, STRIDE_C_TILE_W);

const uint SH_A_BUF = TILE_M * (TILE_K + NUM_ELEMENT_VEC4) / NUM_ELEMENT_VEC4;
const uint SH_B_BUF = TILE_N * (TILE_K + NUM_ELEMENT_VEC4) / NUM_ELEMENT_VEC4;
shared uvec4 sh_a[SH_A_BUF];
shared uvec4 sh_b[SH_B_BUF];

coopmat<C_TYPE, gl_ScopeSubgroup, MAT_M, MAT_N, gl_MatrixUseAccumulator> result[NUM_MAT_SUBTILE_N][NUM_MAT_SUBTILE_M];

layout(buffer_reference) buffer InputA { uvec4 data[]; }    input_a;
layout(buffer_reference) buffer Output { C_TYPE data[]; }   output_o;

layout(set = 0, binding = 0, std430) uniform Params {
    InputA input_a;
    InputA input_b;
    InputA input_c;
    Output output_o;
} params;

layout(local_size_x = NUM_INVOKE_TILE, local_size_y = 1, local_size_z = 1) in;

uvec4 layout_iota(uvec4 shape, uint index) {
    uvec4 coord = uvec4(0);
    uint prod = shape.x;

    coord.x = index % shape.x;
    coord.y = (index / prod) % shape.y; prod *= shape.y;
    coord.z = (index / prod) % shape.z; prod *= shape.z;
    coord.w = index / prod;

    return coord;
}

uvec2 layout_iota(uvec2 shape, uint index) {
    uvec2 coord = uvec2(0);

    coord.x = index % shape.x;
    coord.y = (index / shape.x) % shape.y;

    return coord;
}

uint layout_index(uvec4 stride, uvec4 coord) {
    return stride.x * coord.x + stride.y * coord.y + stride.z * coord.z + stride.w * coord.w;
}

uint layout_index(uvec3 stride, uvec3 coord) {
    return stride.x * coord.x + stride.y * coord.y + stride.z * coord.z;
}

uint layout_index(uvec2 stride, uvec2 coord) {
    return stride.x * coord.x + stride.y * coord.y;
}

void main() {
    // grid.z 是「槽 × k 段」的一维编号：低维 = 段（SPLIT_K 连续），高维 = 槽。
    const uint slot               = gl_WorkGroupID.z;
    const uint split              = slot % SPLIT_K;
    const uint batch              = slot / SPLIT_K;
    const uint tile_m             = gl_WorkGroupID.x;
    const uint tile_n             = gl_WorkGroupID.y;
    const uint subtile_m          = layout_iota(uvec2(NUM_SUBTILE_TILE_M, NUM_SUBTILE_TILE_N), gl_SubgroupID).x;
    const uint subtile_n          = layout_iota(uvec2(NUM_SUBTILE_TILE_M, NUM_SUBTILE_TILE_N), gl_SubgroupID).y;
    const uint local_index        = gl_LocalInvocationIndex;

    InputA input_a                = params.input_a;
    InputA input_b                = params.input_b;
    Output output_o               = params.output_o;

    [[unroll]]
    for (uint i = 0; i < NUM_MAT_SUBTILE_N; ++i) {
        [[unroll]]
        for (uint j = 0; j < NUM_MAT_SUBTILE_M; ++j) {
            result[i][j] = coopmat<C_TYPE, gl_ScopeSubgroup, MAT_M, MAT_N, gl_MatrixUseAccumulator>(0.0);
        }
    }

    uvec4 local_a[TILE_M * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE];
    uvec4 local_b[TILE_N * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE];

    const uint k_first = split * CHUNK_TILE_K;

    // Load A tiles
    [[unroll]]
    for (uint i = 0; i < TILE_M * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE; ++i) {
        uint index = i * NUM_INVOKE_TILE + local_index;
        uvec4 coord = uvec4(layout_iota(SHAPE_A_TILE.xy, index * NUM_ELEMENT_VEC4), k_first, tile_m);
        index = layout_index(STRIDE_A_TILE, coord) + STRIDE_A_BATCH * batch;
        local_a[i] = input_a.data[index / NUM_ELEMENT_VEC4];
    }

    // Load B tiles
    [[unroll]]
    for (uint i = 0; i < TILE_N * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE; ++i) {
        uint index = i * NUM_INVOKE_TILE + local_index;
        uvec4 coord = uvec4(layout_iota(SHAPE_B_TILE.xy, index * NUM_ELEMENT_VEC4), k_first, tile_n);
        index = layout_index(STRIDE_B_TILE, coord) + STRIDE_B_BATCH * batch;
        local_b[i] = input_b.data[index / NUM_ELEMENT_VEC4];
    }

    for (uint iter = 0; iter < CHUNK_TILE_K; ++iter) {
        const uint tile_k = k_first + iter;
        bool last = (iter + 1 >= CHUNK_TILE_K);

        barrier();

        [[unroll]]
        for (uint i = 0; i < TILE_M * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE; ++i) {
            uint index = i * NUM_INVOKE_TILE + local_index;
            uvec2 coord = layout_iota(SHAPE_SH_A_TILE, index * NUM_ELEMENT_VEC4);
            sh_a[layout_index(STRIDE_SH_A_TILE, coord) / NUM_ELEMENT_VEC4] = local_a[i];
        }

        [[unroll]]
        for (uint i = 0; i < TILE_N * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE; ++i) {
            uint index = i * NUM_INVOKE_TILE + local_index;
            uvec2 coord = layout_iota(SHAPE_SH_B_TILE, index * NUM_ELEMENT_VEC4);
            sh_b[layout_index(STRIDE_SH_B_TILE, coord) / NUM_ELEMENT_VEC4] = local_b[i];
        }

        barrier();

        // Prefetch next A tiles
        [[unroll]]
        for (uint i = 0; i < TILE_M * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE; ++i) {
            uint index = i * NUM_INVOKE_TILE + local_index;
            uvec4 coord = uvec4(layout_iota(SHAPE_A_TILE.xy, index * NUM_ELEMENT_VEC4), tile_k + 1, tile_m);
            index = layout_index(STRIDE_A_TILE, coord) + STRIDE_A_BATCH * batch;
            if (!last) local_a[i] = input_a.data[index / NUM_ELEMENT_VEC4];
        }

        // Prefetch next B tiles
        [[unroll]]
        for (uint i = 0; i < TILE_N * TILE_K / NUM_ELEMENT_VEC4 / NUM_INVOKE_TILE; ++i) {
            uint index = i * NUM_INVOKE_TILE + local_index;
            uvec4 coord = uvec4(layout_iota(SHAPE_B_TILE.xy, index * NUM_ELEMENT_VEC4), tile_k + 1, tile_n);
            index = layout_index(STRIDE_B_TILE, coord) + STRIDE_B_BATCH * batch;
            if (!last) local_b[i] = input_b.data[index / NUM_ELEMENT_VEC4];
        }

        // The actual computation
        [[unroll]]
        for (uint mat_k = 0; mat_k < NUM_MAT_SUBTILE_K; ++mat_k) {
            coopmat<A_TYPE, gl_ScopeSubgroup, MAT_M, MAT_K, gl_MatrixUseA> mat_a[NUM_MAT_SUBTILE_M];

            [[unroll]]
            for (uint mat_m = 0; mat_m < NUM_MAT_SUBTILE_M; ++mat_m) {
                uvec3 coord = uvec3(mat_k, mat_m, subtile_m);
                coopMatLoad(mat_a[mat_m], sh_a, layout_index(STRIDE_SH_A_SUBTILE, coord) / NUM_ELEMENT_VEC4, STRIDE_SH_A_MAT.y / NUM_ELEMENT_VEC4, gl_CooperativeMatrixLayoutRowMajor);
            }

            coopmat<A_TYPE, gl_ScopeSubgroup, MAT_K, MAT_N, gl_MatrixUseB> mat_b;

            [[unroll]]
            for (uint mat_n = 0; mat_n < NUM_MAT_SUBTILE_N; ++mat_n) {
                uvec3 coord = uvec3(mat_k, mat_n, subtile_n);
                coopMatLoad(mat_b, sh_b, layout_index(STRIDE_SH_B_SUBTILE, coord) / NUM_ELEMENT_VEC4, STRIDE_SH_B_MAT.y / NUM_ELEMENT_VEC4, gl_CooperativeMatrixLayoutColumnMajor);

                [[unroll]]
                for (uint mat_m = 0; mat_m < NUM_MAT_SUBTILE_M; ++mat_m) {
                    result[mat_n][mat_m] = coopMatMulAdd(mat_a[mat_m], mat_b, result[mat_n][mat_m]);
                }
            }
        }
    }

    [[unroll]]
    for (uint mat_n = 0; mat_n < NUM_MAT_SUBTILE_N; ++mat_n) {
        [[unroll]]
        for (uint mat_m = 0; mat_m < NUM_MAT_SUBTILE_M; ++mat_m) {
            uvec4 coord_0 = uvec4(subtile_m, subtile_n, tile_m, tile_n);
            uvec2 coord_1 = uvec2(mat_m, mat_n);
            uint index = layout_index(STRIDE_C_TILE, coord_0) + layout_index(STRIDE_C_SUBTILE.zw, coord_1) + STRIDE_C_BATCH * slot;

            coopMatStore(result[mat_n][mat_m], output_o.data, index, STRIDE_C_SUBTILE.y, gl_CooperativeMatrixLayoutRowMajor);
        }
    }
}
