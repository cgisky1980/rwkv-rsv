#version 450 core
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

// 把 host-visible 缓冲 in_tok[0]（f32 位模式存 uint 的 token 索引）追加到序列缓冲
// out_seq[cnt]，随后 cnt 自增。供 GPU self-loop 记录每轮生成的 token，便于一次性
// 下载验证序列正确性（无需每轮 CPU 回读）。
// dispatch (1,1,1)，spec 恒空（不重建 pipeline）。

layout(buffer_reference) buffer InTok { uint data[]; } in_tok;
layout(buffer_reference) buffer OutSeq { uint data[]; } out_seq;
layout(buffer_reference) buffer Cnt { uint data[]; } cnt;

layout(set = 0, binding = 0, std430) uniform Params {
    InTok in_tok;
    OutSeq out_seq;
    Cnt cnt;
} params;

// workgroup X = spec 常量（runtime 传设备 subgroup_size）。
// 本 shader 不用 subgroup 指令，但 `create_kernel` 对所有 pipeline 统一设置
// `requiredSubgroupSize` + `REQUIRE_FULL_SUBGROUPS`；此时规范要求
// local_size_x % requiredSubgroupSize == 0（VUID-VkPipelineShaderStageCreateInfo-pNext-02757）。
// 固定写 1 会造出**非法 pipeline**，dispatch 直接 ERROR_DEVICE_LOST（2026-10-03 实录）。
layout(constant_id = 0) const uint WG_SIZE = 32;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

void main() {
    if (gl_LocalInvocationIndex != 0u) return;
    uint i = atomicAdd(params.cnt.data[0], 1u);
    params.out_seq.data[i] = params.in_tok.data[0];
}